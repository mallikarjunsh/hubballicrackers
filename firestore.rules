rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mallikarjun.hubballi@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if orderId.matches('^[0-9]{6}$') &&
        request.resource.data.keys().hasAll([
          'customer', 'items', 'net', 'packing', 'savings', 'total', 'status', 'createdAt'
        ]) &&
        request.resource.data.customer is map &&
        request.resource.data.customer.keys().hasAll([
          'name', 'mobile', 'email', 'city', 'state', 'address'
        ]) &&
        request.resource.data.customer.name is string &&
        request.resource.data.customer.name.size() > 0 &&
        request.resource.data.customer.name.size() <= 100 &&
        request.resource.data.customer.mobile is string &&
        request.resource.data.customer.mobile.matches('^[6-9][0-9]{9}$') &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.items.size() <= 100 &&
        request.resource.data.net is number &&
        request.resource.data.net >= 0 &&
        request.resource.data.total is number;
      allow get, list: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    match /siteAnalytics/{eventId} {
      allow create: if request.resource.data.keys().hasOnly(['event', 'sessionId', 'path', 'createdAt', 'productKey', 'product']) &&
        request.resource.data.event in ['view_product', 'add_to_cart', 'start_order', 'submit_order'];
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
